[Unit]
Description=DadBox power-on light: the rainbow on Play until the service takes over
# ADR 0024 §7. config.txt lights Play from the firmware on; this runs the
# colour-balanced rainbow (systemd/bootlight.py, installed as
# /usr/local/lib/dadbox/bootlight.py) from when systemd starts until the
# service's light driver creates /run/dadbox/bootlight-stop.
# No ordering: everything it needs is on the root, so it needn't wait for /data.
DefaultDependencies=no

[Service]
Type=simple
Environment=LG_WD=/run
ExecStart=/usr/bin/python3 /usr/local/lib/dadbox/bootlight.py

[Install]
WantedBy=sysinit.target
