[Unit]
Description=DadBox voice messaging box
After=network.target sound.target
Wants=network.target

[Service]
Type=notify
User=dadbox
# gpio, audio, i2c, dialout (the modem's AT port): see box/setup/README.md step 5
SupplementaryGroups=gpio audio i2c dialout
WorkingDirectory=/opt/dadbox
ExecStart=/opt/dadbox/.venv/bin/python -m dadbox
Restart=always
RestartSec=3
# The root is a read-only overlay; only /data is writable. /run/dadbox holds the dadboxctl socket.
RuntimeDirectory=dadbox
RuntimeDirectoryMode=0770
ReadWritePaths=/data
Environment=DADBOX_DATA=/data
Environment=DADBOX_CTL=/run/dadbox/ctl.sock
# GPIO through lgpio only (no silent fallback to sysfs, which current kernels reject).
# lgpio writes notification pipes into its working directory: give it the runtime dir.
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=LG_WD=/run/dadbox
# READY=1 after start, WATCHDOG=1 every 30 s while the core thread lives (dadbox/sdnotify.py).
WatchdogSec=60
NotifyAccess=main

[Install]
WantedBy=multi-user.target
