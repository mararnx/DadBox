# LILYGO T-A7670G R2 — ESP32-WROVER: 4 MB flash, 8 MB quad PSRAM. ADR 0013.
# PSRAM is not optional: it holds the ADPCM buffer while the lid is open.
# 4 MB flash: two OTA app slots + NVS; the outbox is on the TF card.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# PPP for esp_modem (M1+)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
